{
  "name": "jp-holidays",
  "version": "1.0.2",
  "description": "日本の祝日を計算する正確で軽量なTypeScriptライブラリ。歴史的な振替休日ルールや特例祝日にも対応。",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "npm run build",
    "check": "biome check .",
    "format": "biome check --write .",
    "lint": "biome lint ."
  },
  "keywords": [
    "japanese",
    "holiday",
    "calendar",
    "japan",
    "祝日",
    "カレンダー"
  ],
  "author": "tsuno08",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsuno08/jp-holidays.git"
  },
  "bugs": {
    "url": "https://github.com/tsuno08/jp-holidays/issues"
  },
  "homepage": "https://github.com/tsuno08/jp-holidays#readme",
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.0.18"
  }
}
